# Local development works with none of these set.

# Model reviews via the Vercel AI SDK and OpenAI. Without it, a
# deterministic demo reviewer runs and the UI says so.
OPENAI_API_KEY=

# Optional model override. Defaults to gpt-5.4-mini.
OPENAI_MODEL=

# Secret for signing demo cookies and Auth.js JWT sessions. Required when
# DEMO_AUTH=1 in production, and required for production OAuth.
AUTH_SECRET=

# Production startup guard: set only for an intentional demo deployment that
# keeps DEMO_AUTH=1 or DEMO_PUBLIC=1 in production.
ALLOW_DEMO_DEPLOY=

# Google OAuth via Auth.js. When both are set, /login shows "Sign in with
# Google" and only ADMIN_EMAIL may sign in until WS-2 invitations ship.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAIL=

# Persona sign-in is local-only by default. Set DEMO_AUTH=1, AUTH_SECRET, and
# APP_ACCESS_CODE intentionally if you deploy the persona demo.
DEMO_AUTH=

# If set, sign-in requires this shared access code.
APP_ACCESS_CODE=

# Public demo: set to 1 (with DEMO_AUTH=1) to let anyone sign in as a persona
# with no access code. Reviews stay on the free deterministic heuristic
# pipeline unless DEMO_PUBLIC_MODEL=1 is also set. On Vercel, pair it with
# DATABASE_URL — without a shared database the submit -> review loop cannot
# cross serverless function boundaries.
DEMO_PUBLIC=

# Public demo live model reviews: set to 1 only if you accept public OpenAI
# spend risk. Also set DEMO_MODEL_DAILY_CAP and an OpenAI-side budget cap.
DEMO_PUBLIC_MODEL=

# Daily public-demo model review cap, counted in UTC days. Defaults to 200.
DEMO_MODEL_DAILY_CAP=

# Global daily model review cap, counted in UTC days. Defaults to 200 and
# supersedes DEMO_MODEL_DAILY_CAP when set.
GLOBAL_MODEL_DAILY_CAP=

# Per-user submission creation limit. Defaults to 10 submissions per 10 minutes.
RATE_LIMIT_SUBMISSIONS=
RATE_LIMIT_WINDOW_MINUTES=

# Max submitted document length in characters. Defaults to 50000.
MAX_DOCUMENT_CHARS=

# Postgres connection string (Neon, Vercel Postgres, or any other provider).
# When set, the app uses Postgres instead of local SQLite.
# Example: postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Set to 0 to skip seeding the demo documents on first run.
SEED_DEMO_DATA=

# ─── Public site, legal and contact ──────────────────────────────────────────
# Canonical origin. Resolves the Open Graph image, canonical URLs, robots.txt
# and sitemap.xml. Falls back to the Vercel production URL, then localhost.
NEXT_PUBLIC_SITE_URL=

# Who operates the service, and how to reach them. Until these are set, the
# footer and the legal pages say so in the UI rather than shipping a blank or
# an invented address. All four are required before publishing.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_JURISDICTION=
# Optional; defaults to NEXT_PUBLIC_CONTACT_EMAIL.
NEXT_PUBLIC_PRIVACY_EMAIL=

# ─── Analytics (off unless set) ──────────────────────────────────────────────
# An https script URL — no vendor is baked in. NEXT_PUBLIC_ANALYTICS_ID is
# passed to it as data-domain.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_ID=
# Set to 1 ONLY for a provider that stores cookies or other state on the
# device. That is what makes the consent banner appear; nothing loads until
# the visitor accepts. A cookieless provider needs no banner and gets none.
NEXT_PUBLIC_ANALYTICS_USES_COOKIES=
